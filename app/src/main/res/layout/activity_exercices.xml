<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExercicesActivity">

    <TextView
        android:id="@+id/tvETexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="35dp"
        android:text="@string/eaText"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnEReproducir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="35dp"
        android:text=" == ▶ Reproducir  == "
        android:backgroundTint="@color/bg_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvETexto" />

    <Button
        android:id="@+id/btnEOp1"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"
        android:text="@string/eaop1"
        android:backgroundTint="@color/bg_menu"
        app:shapeAppearanceOverlay="@style/btn_Recto"
        app:layout_constraintBottom_toTopOf="@+id/btnEVolver"
        app:layout_constraintEnd_toStartOf="@+id/btnEOp2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnEOp2"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_marginBottom="50dp"
        android:text="@string/eaop2"
        android:backgroundTint="@color/bg_menu"
        app:shapeAppearanceOverlay="@style/btn_Recto"
        app:layout_constraintBottom_toTopOf="@+id/btnEVolver"
        app:layout_constraintEnd_toStartOf="@+id/btnEOp3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnEOp1" />

    <Button
        android:id="@+id/btnEOp3"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="50dp"
        android:text="@string/eaop3"
        android:backgroundTint="@color/bg_menu"
        app:shapeAppearanceOverlay="@style/btn_Recto"
        app:layout_constraintBottom_toTopOf="@+id/btnEVolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnEOp2" />

    <Button
        android:id="@+id/btnEVolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="150dp"
        android:text="@string/eavolver"
        android:backgroundTint="@color/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="35dp"
        android:text="Ejercicios de Listening"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>